#!/bin/bash
# ============================================
# RSV Tech Solutions - One-Click Deploy
# ============================================
# Usage: deploy <project-name> <repo-url> <domain> [port]

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

if [ $# -lt 3 ]; then
    echo -e "${RED}Usage: deploy <project> <repo> <domain> [port]${NC}"
    echo ""
    echo "Examples:"
    echo "  deploy printer-managment https://github.com/user/printer.git printer.rvstechsolution.com"
    echo "  deploy possim https://github.com/user/possim.git sellsim.kneayerng.com 3001"
    exit 1
fi

PROJECT="$1"
REPO="$2"
DOMAIN="$3"
PORT="${4:-8080}"

DIR="/var/www/${PROJECT}"
TEMPLATE_DIR="/opt/rsv-deploy/templates"
PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' | head -c 24)
JWT=$(openssl rand -base64 32 | tr -d '/+=' | head -c 32)

echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}  RSV Tech Solutions - Deploy${NC}"
echo -e "${BLUE}========================================${NC}"
echo ""
echo -e "  Project:  ${GREEN}${PROJECT}${NC}"
echo -e "  Domain:   ${GREEN}${DOMAIN}${NC}"
echo -e "  Port:     ${GREEN}${PORT}${NC}"
echo ""

# Step 1: Clone
echo -e "${YELLOW}[1/6]${NC} Getting code..."
if [ -d "$DIR" ]; then
    cd "$DIR"
    git pull 2>/dev/null || true
else
    git clone "$REPO" "$DIR"
    cd "$DIR"
fi

# Step 2: Detect project type
echo -e "${YELLOW}[2/6]${NC} Detecting project type..."
if [ -f "package.json" ] && [ ! -f "composer.json" ]; then
    PROJECT_TYPE="node"
    echo -e "  ${GREEN}Node.js project detected${NC}"
elif [ -f "composer.json" ]; then
    PROJECT_TYPE="laravel"
    echo -e "  ${GREEN}Laravel project detected${NC}"
else
    PROJECT_TYPE="node"
    echo -e "  ${YELLOW}Unknown type, defaulting to Node.js${NC}"
fi

# Step 3: Create .env
echo -e "${YELLOW}[3/6]${NC} Creating .env..."
DB_NAME=$(echo "${PROJECT}" | tr '-' '_')

if [ "$PROJECT_TYPE" = "node" ]; then
    cat > .env << EOF
PORT=3000
JWT_SECRET=${JWT}
DB_HOST=${PROJECT}_db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=${PASSWORD}
DB_NAME=${DB_NAME}_db
REDIS_HOST=${PROJECT}_redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DISABLED=false
APP_DOMAIN=${DOMAIN}
APP_PORT=${PORT}
EOF
else
    cat > .env << EOF
APP_DOMAIN=${DOMAIN}
DB_DATABASE=${DB_NAME}_db
DB_USERNAME=${DB_NAME}
DB_PASSWORD=${PASSWORD}
APP_PORT=${PORT}
EOF
fi

# Step 4: Create docker-compose.prod.yml if missing
echo -e "${YELLOW}[4/6]${NC} Setting up Docker..."
if [ ! -f "docker-compose.prod.yml" ]; then
    if [ "$PROJECT_TYPE" = "node" ]; then
        cp "${TEMPLATE_DIR}/docker-compose.node.yml" docker-compose.prod.yml
    else
        cp "${TEMPLATE_DIR}/docker-compose.prod.yml" docker-compose.prod.yml
    fi
    sed -i "s/\${PROJECT_NAME}/${PROJECT}/g" docker-compose.prod.yml
    sed -i "s/\${DB_NAME}/${DB_NAME}_db/g" docker-compose.prod.yml
    sed -i "s/\${JWT_SECRET}/${JWT}/g" docker-compose.prod.yml
fi

# Step 5: Build & Start
echo -e "${YELLOW}[5/6]${NC} Building containers..."
docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# Step 6: Done
echo -e "${YELLOW}[6/6]${NC} Finalizing..."
sleep 5

echo ""
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}  DEPLOYMENT COMPLETE${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""
echo -e "  ${BLUE}Containers:${NC}"
docker ps --filter "name=${PROJECT}" --format "  {{.Names}}  {{.Status}}"
echo ""
echo -e "  ${BLUE}Add in Cloudflare Tunnel:${NC}"
echo -e "    Hostname: ${DOMAIN}"
echo -e "    Service:  HTTP"
echo -e "    URL:      localhost:${PORT}"
echo ""
echo -e "  ${YELLOW}DB Password: ${PASSWORD}${NC}"
echo -e "  ${YELLOW}(Saved in ${DIR}/.env)${NC}"
echo ""
